{
    "name": "quillstack/middleware",
    "description": "The middleware library based on PSR-15: HTTP Server Request Handlers.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "middleware",
        "php",
        "psr",
        "psr-15",
        "php8"
    ],
    "homepage": "https://quillstack.org/packages/middleware",
    "authors": [
        {
            "name": "Radek Ziemniewicz",
            "email": "radek@quillstack.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "quillstack/response": "^0.7",
        "quillstack/router": "^0.7"
    },
    "autoload": {
        "psr-4": {
            "Quillstack\\Middleware\\": "src/",
            "Quillstack\\Middleware\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "quillstack/unit-tests": "^0.9"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        }
    },
    "scripts": {
        "test": "unit-tests",
        "test:coverage": "phpdbg -qrr vendor/bin/unit-tests",
        "stan": "phpstan analyse"
    }
}
